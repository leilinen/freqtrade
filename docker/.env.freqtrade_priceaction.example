# Copy to docker/.env.freqtrade_priceaction on the target host.
# Do not commit the real file; it contains deployment secrets.

# Absolute path to the new dev_pa_agent checkout user_data directory.
USERDATA_DIR=/home/azureuser/freqtrade-pa-agent/user_data

# LLM credentials. pa_llm_api_key is not stored in config JSON.
DEEPSEEK_API_KEY=
PA_LLM_BASE_URL=
PA_LLM_MODEL=

# Dedicated Telegram bot credentials for the new parallel stack.
TG_TOKEN=
TG_CHAT_ID=

# Independent database used by the new freqtrade_priceaction stack.
PA_DB_URL=postgresql://postgres:postgres@postgres:5432/freqtrade_priceaction
