FROM python:3.12-slim-bookworm

# System deps (TA-Lib C library)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential wget autoconf automake libtool && \
    cd /tmp && wget -q http://prdownloads.sourceforge.net/ta-lib/ta-lib-0.4.0-src.tar.gz && \
    tar -xzf ta-lib-0.4.0-src.tar.gz && cd ta-lib && \
    autoreconf -fi && \
    ./configure --prefix=/usr && make && make install && \
    rm -rf /tmp/ta-lib* && \
    apt-get remove -y wget autoconf automake libtool && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /freqtrade

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN pip install --no-cache-dir -e .
RUN pip install --no-cache-dir psycopg2-binary mplfinance

# Patch ccxt keysort to handle None keys from OKX API (ccxt 4.5.56 bug)
RUN sed -i 's/return dict(sorted(dictionary.items()))/return dict(sorted((k, v) for k, v in dictionary.items() if k is not None))/' \
    /usr/local/lib/python3.12/site-packages/ccxt/base/exchange.py

ENTRYPOINT ["freqtrade"]
CMD ["trade"]
