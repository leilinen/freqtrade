# PA watch deployment secrets — copy to docker/.env and fill in:
#   cp docker/.env.example docker/.env
# Used by docker/docker-compose-watch.yml. docker/.env is gitignored —
# never commit real keys.

# LLM provider (DeepSeek-compatible OpenAI endpoint)
PA_LLM_API_KEY=
PA_LLM_BASE_URL=https://api.deepseek.com

# PostgreSQL (freqtrade trades + pa signal/analysis_record tables)
POSTGRES_PASSWORD=postgres

# Telegram (native freqtrade bot; leave TG_ENABLED=false until tokens are set)
TG_ENABLED=false
TG_TOKEN=
TG_CHAT_ID=

# Container timezone
TZ=Asia/Shanghai
